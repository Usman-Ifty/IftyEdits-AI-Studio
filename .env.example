# Copy to .env and fill in locally. Never commit .env.
# Placeholders only. No real values belong in this file.
# Precedence: process environment > .env > built-in defaults.
# Relative paths resolve against IFTYEDITS_HOME (default: the current directory).

# Root directory for application data (originals vault, staging, derived media, database).
IFTYEDITS_DATA_DIR=./data

# Directory for downloaded model weights (kept out of git).
IFTYEDITS_MODELS_DIR=./models

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
IFTYEDITS_LOG_LEVEL=INFO

# ffprobe executable (name on PATH or absolute path) and per-file timeout in seconds.
IFTYEDITS_FFPROBE_PATH=ffprobe
IFTYEDITS_PROBE_TIMEOUT_S=60

# ffmpeg executable and the maximum run time of one processing step, in seconds (default 6 h).
IFTYEDITS_FFMPEG_PATH=ffmpeg
IFTYEDITS_FFMPEG_TIMEOUT_S=21600

# H.264 encoder for 720p proxies: auto (VideoToolbox when a test encode succeeds,
# otherwise libx264), h264_videotoolbox (falls back to libx264 if unusable) or libx264.
IFTYEDITS_PROXY_ENCODER=auto

# Imports are refused if they would leave less than this many bytes free (default 2 GiB).
IFTYEDITS_MIN_FREE_BYTES=2147483648

# Comma-separated file extensions accepted for import.
IFTYEDITS_VIDEO_EXTENSIONS=.mp4,.m4v,.mov,.mkv,.webm,.avi,.mts,.m2ts,.mxf

# --- Transcription (Phase 1C) ---
# Default speech model: tiny, base, small, medium, large-v3-turbo or large-v3.
# Models are downloaded only when you ask (Transcripts page or `iftyedits models download`).
#IFTYEDITS_TRANSCRIPTION_MODEL=small
IFTYEDITS_TRANSCRIPTION_MODEL=tiny
# Spoken language: auto (detect) or a code such as en, ur, hi, es.
IFTYEDITS_TRANSCRIPTION_LANGUAGE=auto
# CPU weight precision: int8 (fastest), int8_float32 or float32.
IFTYEDITS_TRANSCRIPTION_COMPUTE_TYPE=int8
# CPU threads for inference; 0 lets faster-whisper choose.
IFTYEDITS_TRANSCRIPTION_CPU_THREADS=0
IFTYEDITS_TRANSCRIPTION_BEAM_SIZE=5
# Skip silence with voice-activity detection (reduces made-up text in quiet parts).
IFTYEDITS_TRANSCRIPTION_VAD=true
IFTYEDITS_TRANSCRIPTION_WORD_TIMESTAMPS=true
# A transcription job fails after this many seconds (default 6 hours).
IFTYEDITS_TRANSCRIPTION_TIMEOUT_S=21600

# --- YouTube link ingestion (yt-dlp, no cookies or login) ---
# Refuse videos longer than this many seconds (default 4 hours).
IFTYEDITS_URL_MAX_DURATION_S=14400
# A download fails after this many seconds (default 1 hour).
IFTYEDITS_URL_DOWNLOAD_TIMEOUT_S=3600
# Largest download accepted, in megabytes.
IFTYEDITS_URL_MAX_FILESIZE_MB=4096

# --- Optional, later phases ---
# YouTube OAuth client file path (stored outside the repository).
# IFTYEDITS_YOUTUBE_CLIENT_SECRETS=/absolute/path/outside/repo/client_secret.json

# Optional LLM API key for SEO generation. Leave empty for local-only mode.
# ANTHROPIC_API_KEY=
